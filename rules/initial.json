{
  "schema_version": 1,
  "rule_pack_version": 1,
  "rules": [
    {
      "schema_version": 1,
      "rule_version": 1,
      "id": "chrome-signing-copies",
      "name": "Chrome signing copies",
      "path_patterns": ["/private/var/folders/**/com.google.Chrome.code_sign_clone/code_sign_clone.*", "/var/folders/**/com.google.Chrome.code_sign_clone/code_sign_clone.*"],
      "volumes": ["any_mounted_local"],
      "ownership": "chrome_clone_directory",
      "liveness": ["chrome_family_stopped", "liveness_not_in_use"],
      "eligibility": [],
      "age_threshold_days": 1,
      "measurement": "clone_aware_unique_bytes",
      "route": "trash",
      "route_detail": "Move to Trash; report clone-aware unique bytes",
      "risk": "review",
      "report_only": true
    },
    {
      "schema_version": 1,
      "rule_version": 1,
      "id": "orphan-build-workspaces",
      "name": "Orphaned build workspaces",
      "path_patterns": ["/Volumes/*/.rightkit-managed/workspaces/**", "/Volumes/*/.rightkit-managed/ws/**"],
      "volumes": ["external_volume"],
      "ownership": "owner_tool_state",
      "liveness": ["owner_state_complete", "source_root_confirmed_absent", "owner_lease_inactive", "active_residents_stopped", "liveness_not_in_use"],
      "eligibility": [],
      "age_threshold_days": 1,
      "measurement": "attributed_allocation",
      "route": "owner_tool",
      "route_detail": "Owning tool prune API when available; otherwise Move to Trash",
      "risk": "review",
      "report_only": true
    },
    {
      "schema_version": 1,
      "rule_version": 1,
      "id": "stale-build-temp",
      "name": "Stale build temp and run folders",
      "path_patterns": ["/Volumes/*/.build-home/**/tmp*", "/Volumes/*/.build-home/**/runs/**"],
      "volumes": ["external_volume"],
      "ownership": "exact_path",
      "liveness": ["active_residents_stopped", "liveness_not_in_use"],
      "eligibility": [],
      "age_threshold_days": 14,
      "measurement": "attributed_allocation",
      "route": "trash",
      "route_detail": "Move to Trash",
      "risk": "review",
      "report_only": true
    },
    {
      "schema_version": 1,
      "rule_version": 1,
      "id": "stale-graph-index",
      "name": "Stale graph and index files",
      "path_patterns": ["/Volumes/*/**/.graph/**", "/Volumes/*/**/.index/**", "/Volumes/*/**/graph*.json", "/Volumes/*/**/index*.db"],
      "volumes": ["any_mounted_local"],
      "ownership": "owner_tool_state",
      "liveness": ["generator_stopped", "liveness_not_in_use"],
      "eligibility": ["replacement_newer"],
      "age_threshold_days": 30,
      "measurement": "attributed_allocation",
      "route": "trash",
      "route_detail": "Move to Trash; regenerate on demand",
      "risk": "review",
      "report_only": true
    },
    {
      "schema_version": 1,
      "rule_version": 1,
      "id": "agent-temp-model-cache",
      "name": "Agent temp and model caches",
      "path_patterns": ["/Volumes/*/**/tmp/local-assistants-*/**", "/Volumes/*/**/.cache/huggingface/**", "/Volumes/*/**/.cache/models/**"],
      "volumes": ["external_volume"],
      "ownership": "exact_path",
      "liveness": ["active_residents_stopped", "liveness_not_in_use"],
      "eligibility": ["model_cache_redownloadable"],
      "age_threshold_days": 30,
      "measurement": "attributed_allocation",
      "route": "trash",
      "route_detail": "Move to Trash after explicit review; cache is never Safe",
      "risk": "review",
      "report_only": true
    },
    {
      "schema_version": 1,
      "rule_version": 1,
      "id": "workspace-trash",
      "name": "Workspace trash folders",
      "path_patterns": ["/Volumes/*/.workspace-trash/**"],
      "volumes": ["external_volume"],
      "ownership": "exact_path",
      "liveness": ["liveness_not_in_use"],
      "eligibility": [],
      "age_threshold_days": 30,
      "measurement": "attributed_allocation",
      "route": "trash",
      "route_detail": "Delete only after explicit review; contents were already discarded once",
      "risk": "review",
      "report_only": true
    },
    {
      "schema_version": 1,
      "rule_version": 1,
      "id": "obsolete-app-backups",
      "name": "Obsolete app backups",
      "path_patterns": ["/Applications/*.app.prev-*", "/Applications/*.app.pre-*"],
      "volumes": ["startup_volume"],
      "ownership": "app_bundle_backup",
      "liveness": ["app_process_stopped", "liveness_not_in_use"],
      "eligibility": ["replacement_newer"],
      "age_threshold_days": 1,
      "measurement": "attributed_allocation",
      "route": "trash",
      "route_detail": "Move to Trash only when newer app is present",
      "risk": "review",
      "report_only": true
    },
    {
      "schema_version": 1,
      "rule_version": 1,
      "id": "xcode-artifacts",
      "name": "Xcode simulator and DeviceSupport artifacts",
      "path_patterns": ["/Users/*/Library/Developer/CoreSimulator/Devices/**", "/Library/Developer/CoreSimulator/Profiles/Runtimes/**", "/Users/*/Library/Developer/Xcode/iOS DeviceSupport/**"],
      "volumes": ["any_mounted_local"],
      "ownership": "app_managed",
      "liveness": ["simulator_not_in_use", "liveness_not_in_use"],
      "eligibility": [],
      "age_threshold_days": 30,
      "measurement": "attributed_allocation",
      "route": "simctl",
      "route_detail": "Use simctl for runtimes/devices; Move DeviceSupport to Trash",
      "risk": "review",
      "report_only": true
    },
    {
      "schema_version": 1,
      "rule_version": 1,
      "id": "app-leftovers",
      "name": "App leftovers",
      "path_patterns": ["/Users/*/Library/Application Support/**", "/Users/*/Library/Caches/**", "/Users/*/Library/Preferences/**", "/Users/*/Library/Containers/**", "/Users/*/Library/Group Containers/**", "/Library/Application Support/**", "/Library/Preferences/**"],
      "volumes": ["any_mounted_local"],
      "ownership": "installed_app_history",
      "liveness": ["app_process_stopped", "liveness_not_in_use"],
      "eligibility": ["app_not_installed", "inventory_complete"],
      "age_threshold_days": 30,
      "measurement": "attributed_allocation",
      "route": "trash",
      "route_detail": "Move to Trash; exact bundle ownership required",
      "risk": "review",
      "report_only": true
    },
    {
      "schema_version": 1,
      "rule_version": 1,
      "id": "swap-explanation",
      "name": "Swap usage explanation",
      "path_patterns": [],
      "volumes": [],
      "ownership": "explanation_only",
      "liveness": [],
      "eligibility": [],
      "age_threshold_days": null,
      "measurement": "explanation_only",
      "route": "none",
      "risk": "review",
      "report_only": true,
      "explanation": "Swap is a memory-pressure signal; it is not a cleanup target."
    },
    {
      "schema_version": 1,
      "rule_version": 1,
      "id": "snapshots-explanation",
      "name": "Local snapshot explanation",
      "path_patterns": [],
      "volumes": [],
      "ownership": "explanation_only",
      "liveness": [],
      "eligibility": [],
      "age_threshold_days": null,
      "measurement": "explanation_only",
      "route": "none",
      "risk": "review",
      "report_only": true,
      "explanation": "Snapshots can retain deleted data; retention is unknown until snapshot state is measured."
    },
    {
      "schema_version": 1,
      "rule_version": 1,
      "id": "whatsapp-explanation",
      "name": "WhatsApp media explanation",
      "path_patterns": [],
      "volumes": [],
      "ownership": "app_managed",
      "liveness": [],
      "eligibility": [],
      "age_threshold_days": null,
      "measurement": "explanation_only",
      "route": "none",
      "risk": "review",
      "report_only": true,
      "explanation": "Use WhatsApp managed storage controls; never delete its databases or containers generically."
    }
  ]
}
