{
  "schemaVersion": 1,
  "compile": "github-actions-only",
  "lanes": [
    "ci",
    "release-candidate"
  ],
  "matrix": {
    "os": [
      "xcode-27",
      "windows-2025"
    ],
    "node": [
      "26.8.1"
    ]
  },
  "packageManager": "pnpm@11.24.0",
  "templateVersion": "1.8.0",
  "profile": "rust-hybrid",
  "rustCache": {
    "workspaces": [
      ".",
      "windows",
      "hub/src-tauri",
      "hub/qa-e2e"
    ],
    "requiredForGate": true,
    "keySuffix": "r1"
  },
  "gate": {
    "path": "scripts/gate.sh"
  },
  "candidate": {
    "buildScript": "release:candidate",
    "checkScript": "release:check",
    "admissionScript": "release:admit",
    "stageSummaryScript": "release:summary",
    "artifactRoot": "cockpit-candidate",
    "os": [
      "xcode-27",
      "windows-2025"
    ],
    "targets": [
      {
        "os": "xcode-27",
        "platform": "macos",
        "architecture": "arm64"
      },
      {
        "os": "windows-2025",
        "platform": "windows",
        "architecture": "x86_64"
      }
    ],
    "signMacos": true,
    "signWindows": true
  },
  "qaEvidencePath": "pulse-hub-qa",
  "qaEvidenceRetentionDays": 7,
  "ciAllOs": true,
  "ciIncremental": true,
  "devArtifact": {
    "mac": "sign",
    "windows": "unsigned",
    "retentionDays": 7,
    "macAppPath": "dist/dev/Pulse.app",
    "windowsGlob": "dist/dev/windows/**",
    "parallel": true,
    "buildScript": "dev:artifact"
  },
  "concurrency": {
    "mainPushes": "queue"
  }
}
